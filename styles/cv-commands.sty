\newcommand{\projectHeading}[3]{\Project{#1}{#2}
\descript{#3}\\}
\newcommand{\volunteerHeading}[3]{\runsubsection{\uppercase{#1}}\descript{ | #2}\hfill\location{#3}\fakeNewLine}
\newcommand{\pubHeading}[5]{\runsubsection{#1}\hfill\location{#2}\\
#3\\
\descript{#4} \quad #5\fakeNewLine}
\newcommand{\achievementHeading}[3]{\runsubsection{#1}\descript{ | #2}\hfill\location{#3}\fakeNewLine}

